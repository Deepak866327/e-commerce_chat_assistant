# Defaults preserve the existing model registration; supply the external GGUF.
SHOPASSIST_OLLAMA_URL=http://localhost:11434
SHOPASSIST_ANSWER_MODEL=shopassist-finetuned
SHOPASSIST_UTILITY_MODEL=qwen2.5:1.5b
SHOPASSIST_FAQ_MODEL=shopassist-finetuned
SHOPASSIST_VERIFIER_MODEL=qwen2.5:1.5b
SHOPASSIST_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SHOPASSIST_EMBEDDING_REVISION=local-v1
SHOPASSIST_CHUNK_TOKENS=500
SHOPASSIST_CHUNK_OVERLAP=75
SHOPASSIST_DENSE_K=20
SHOPASSIST_KEYWORD_K=20
SHOPASSIST_FUSION_K=15
SHOPASSIST_CONTEXT_K=4
SHOPASSIST_CONTEXT_TOKENS=2000
SHOPASSIST_USE_RERANKER=false
SHOPASSIST_RERANKER_MODEL=BAAI/bge-reranker-base
SHOPASSIST_MODEL_TIMEOUT=90
SHOPASSIST_RETENTION_DAYS=30
SHOPASSIST_REQUESTS_PER_MINUTE=20
SHOPASSIST_FAQ_PER_CHUNK=5
# Enable downloads only during explicit provisioning, then turn off.
SHOPASSIST_ALLOW_MODEL_DOWNLOAD=false
# Hosted deployments: configure Streamlit OIDC and set this true.
SHOPASSIST_REQUIRE_LOGIN=false
# Migration only: legacy keeps a deployed v1 index working during validation.
# New installs and validated releases should use grounded.
SHOPASSIST_PIPELINE=grounded
# Create hashes with: python -m src.admin hash-password
# SHOPASSIST_ADMIN_PASSWORD_HASH=
# SHOPASSIST_REVIEWER_PASSWORD_HASH=
# SHOPASSIST_EVALUATOR_PASSWORD_HASH=
# SHOPASSIST_SUPPORT_PASSWORD_HASH=
# Optional contact collection: generate a Fernet key once and keep it secret.
# SHOPASSIST_TICKET_ENCRYPTION_KEY=
SHOPASSIST_TICKET_RETENTION_DAYS=90
# Distinct customer-facing support attempts, not internal generation retries.
SHOPASSIST_SUPPORT_MAX_ATTEMPTS=3
# FAQ search uses cached local embeddings when available, otherwise keyword search.
SHOPASSIST_FAQ_SEARCH_MIN_SIMILARITY=0.55
# Keep semantic auto-answers disabled until evaluated on your own FAQ queries.
# Exact approved questions can be answered directly in English; other chat uses RAG.
SHOPASSIST_FAQ_SEMANTIC_ANSWERS=false
SHOPASSIST_FAQ_ANSWER_MIN_SIMILARITY=0.90
SHOPASSIST_FAQ_ANSWER_MARGIN=0.12
